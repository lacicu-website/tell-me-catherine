<% const section = "mybook"; -%>
<section class="section section--wave <%= section %>">
  <div class="section__inner <%= section %>__inner">
    <div class="<%= section %>__card">
      <img class="<%= section %>__image <%= section %>__image--sp" src="../images/oshiete/mybook/mybook-card-sp@2x.png" alt="MY BOOK" loading="lazy" />
      <img class="<%= section %>__image <%= section %>__image--pc" src="../images/oshiete/mybook/mybook-card-pc@2x.png" alt="MY BOOK" loading="lazy" />
      <div class="<%= section %>__content">
        <h2 class="<%= section %>__header">MY BOOK</h2>
        <p class="<%= section %>__text">鑑定結果や宿命、相性、運気の流れなど<br class="hidden-pc">を<br class="hidden-sp">一冊にまとめた、あなただけの特別な<br class="hidden-pc">ノート。<br class="hidden-sp">迷ったとき、立ち止まったとき、<br>いつでも開いて自分らしい選択を思い<br class="hidden-pc">出せる<br class="hidden-sp">人生のガイドブックです。</p>
      </div>
    </div>
  </div>
</section>
