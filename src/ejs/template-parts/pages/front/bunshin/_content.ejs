<% const section = "bunshin"; -%>
<section class="section section--wave <%= section %>">
  <div class="section__inner <%= section %>__inner">
    <h2 class="section__header <%= section %>__header"><span class="num">60</span>種の宿命をキャラクター化。<br>自分らしさを映し出す、<br>もうひとりの分身<span class="ml">「BUNSHIN」</span>。</h2>
    <p class="section__text <%= section %>__text">算命学における<span class="num">60</span>種類の宿命をキャラクターとして表現した存在です。<br>性格や才能、価値観、人生のテーマを映し出す“もうひとりの自分”として、<br>自分らしさを知るきっかけを届けます。</p>
    <div class="<%= section %>__card">
      <img src="../images/oshiete/bunshin/bunshin-card-pc@2x.png" alt="No.3 ヒノトラン 丙寅 冷静さと行動力を併せ持つ指導者" loading="lazy" />
    </div>
    <div class="<%= section %>__link-container">
      <a class="<%= section %>__link" href="<%= links.bunshin %>">
        <img class="<%= section %>__link-bg <%= section %>__link-bg--sp" src="../images/oshiete/bunshin/bunshin-link-sp@2x.png" alt="あなたのBUNSHINを占う" loading="lazy" />
        <img class="<%= section %>__link-bg <%= section %>__link-bg--pc" src="../images/oshiete/bunshin/bunshin-link-pc@2x.png" alt="あなたのBUNSHINを占う" loading="lazy" />
        <img class="<%= section %>__link-button <%= section %>__link-button--sp" src="../images/oshiete/bunshin/bunshin-button-sp@2x.png" alt="GO" loading="lazy" />
        <img class="<%= section %>__link-button <%= section %>__link-button--pc" src="../images/oshiete/bunshin/bunshin-button-pc@2x.png" alt="GO" loading="lazy" />
      </a>
    </div>
  </div>
</section>
