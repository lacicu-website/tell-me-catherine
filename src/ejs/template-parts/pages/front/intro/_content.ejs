<% const section = "intro"; -%>
<section class="section <%= section %>">
  <div class="section__inner <%= section %>__inner">
    <h2 class="<%= section %>__header">宿命を知ると、<br class="hidden-pc">人生はもっとラクになる。</h2>
    <p class="<%= section %>__text">
      仕事、恋愛、人間関係。人生の迷いには、<br class="hidden-pc">宿命というヒントがあります。<br>おしえてキャサリンは、算命学とAIで、<br class="hidden-pc">宿命・相性・運気の流れを読み解くサービス。<br>自分を知り、相手を知り、<br class="hidden-pc">好機を図るための人生の地図です。
    </p>
    <a class="<%= section %>__button" href="<%= links.catherine %>">
      <img class="<%= section %>__button-image <%= section %>__button-image--sp" src="../images/oshiete/intro/intro-button-sp@2x.png" alt="おしえてキャサリン 無料で始める" />
      <img class="<%= section %>__button-image <%= section %>__button-image--pc" src="../images/oshiete/intro/intro-button-pc@2x.png" alt="おしえてキャサリン 無料で始める" />
    </a>
  </div>
  <img class="<%= section %>__flower <%= section %>__flower--left" src="../images/oshiete/intro/intro-flower-left@2x.png" alt="" />
  <img class="<%= section %>__flower <%= section %>__flower--right" src="../images/oshiete/intro/intro-flower-right@2x.png" alt="" />
</section>
