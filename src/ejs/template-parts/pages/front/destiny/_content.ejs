<% const section = "destiny"; -%>
<section class="section section--wave feature <%= section %>">
  <div class="section__inner feature__inner <%= section %>__inner">
    <h2 class="feature__title <%= section %>__title">
      <img src="../images/oshiete/destiny/destiny-title@2x.png" alt="宿命" loading="lazy" />
    </h2>
    <div class="feature__content <%= section %>__content">
      <h3 class="section__header feature__header <%= section %>__header">自分自身や気になる<br>あの人の取扱説明書</h3>
      <p class="section__text feature__text <%= section %>__text">仕事、恋愛、人間関係。<br>人生の迷いには、宿命というヒントがあります。<br class="hidden-tb">おしえてキャサリンは、算命学とAIで、<br class="hidden-tb">宿命・相性・運気の流れを読み解くサービス。<br class="hidden-tb">自分を知り、相手を知り、好機を図るための人生の地図です。</p>
      <img class="feature__image <%= section %>__image" src="../images/oshiete/destiny/destiny-image@2x.png" alt="BUNSHINと星のイラスト" loading="lazy" />
    </div>
    <img class="feature__decoration <%= section %>__decoration" src="../images/oshiete/destiny/destiny-crystal-pc@2x.png" alt="" loading="lazy" />
  </div>
</section>
