<% const section = "compatibility"; -%>
<section class="section section--wave feature <%= section %>">
  <div class="section__inner feature__inner <%= section %>__inner">
    <h2 class="feature__title <%= section %>__title">
      <img src="../images/oshiete/compatibility/compatibility-title@2x.png" alt="相性" loading="lazy" />
    </h2>
    <div class="feature__content <%= section %>__content">
      <div class="<%= section %>__block">
      <h3 class="feature__header <%= section %>__header">惹かれ合う理由も、<br class="hidden-pc">すれ違う理由も。</h3>
      <p class="feature__text <%= section %>__text">恋愛、結婚、仕事、家族など、<br class="hidden-pc">二人の関係性を多角的に分析。<br>相手の考え方や行動パターンを知ることで、<br class="hidden-tb">より良い関係づくりのヒントが見えてきます。</p>
      </div>
      <img class="feature__image <%= section %>__image" src="../images/oshiete/compatibility/compatibility-image@2x.png" alt="キノエネ ツチノトウ 相性71%" loading="lazy" />
    </div>
    <img class="feature__decoration <%= section %>__decoration" src="../images/oshiete/compatibility/compatibility-mountain-pc@2x.png" alt="" loading="lazy" />
  </div>
</section>
