<% const section = "talk"; -%>
<section class="section <%= section %>">
  <img class="<%= section %>__wave <%= section %>__wave--sp" src="../images/oshiete/talk/talk-wave-line-sp@2x.png" alt="" loading="lazy" />
  <img class="<%= section %>__wave <%= section %>__wave--pc" src="../images/oshiete/talk/talk-wave-line-pc@2x.png" alt="" loading="lazy" />

  <img class="<%= section %>__decoration <%= section %>__decoration--clock" src="../images/oshiete/talk/talk-clock-pc@2x.png" alt="" loading="lazy" />
  <h2 class="<%= section %>__title">
    <img class="<%= section %>__title-image <%= section %>__title-image--sp" src="../images/oshiete/talk/talk-title-sp@2x.png" alt="キャサリンTalk" loading="lazy" />
    <img class="<%= section %>__title-image <%= section %>__title-image--pc" src="../images/oshiete/talk/talk-title-pc@2x.png" alt="キャサリンTalk" loading="lazy" />
  </h2>
  <div class="section__inner <%= section %>__upper">
    <img class="<%= section %>__decoration <%= section %>__decoration--potion" src="../images/oshiete/talk/talk-potion-pc@2x.png" alt="" loading="lazy" />


    <p class="<%= section %>__text">24時間365日、算命学に精通した親友・キャサリンと話せる<br class="hidden-sp">チャットサービス。<br class="hidden-pc">あなたの宿命や運気の流れをもとに、<br class="hidden-sp">仕事、恋愛、人間関係などの悩みに寄り添います。<br>「転職するなら今？」「彼の気持ちがわからない」<br class="hidden-sp">「最近なんだかうまくいかない」そんな日々の迷いに、<br class="hidden-sp">算命学の視点でアドバイス。<br class="hidden-pc">運勢を伝えるだけでなく、<br class="hidden-sp">あなたらしい選択を一緒に考えます。</p>
    <div class="<%= section %>__phone">
      <img class="<%= section %>__phone-image <%= section %>__phone-image--sp" src="../images/oshiete/talk/talk-phone-sp@2x.png" alt="まるで、算命学が大好きな親友がスマホの中にいるみたい。" loading="lazy" />
      <img class="<%= section %>__phone-image <%= section %>__phone-image--pc" src="../images/oshiete/talk/talk-phone-pc@2x.png" alt="まるで、算命学が大好きな親友がスマホの中にいるみたい。" loading="lazy" />
    </div>
  </div>
  <div class="section__inner <%= section %>__bottom">
    <div class="<%= section %>__who">
      <img class="<%= section %>__sparkle <%= section %>__sparkle--top" src="../images/oshiete/talk/talk-stars-small@2x.png" alt="" loading="lazy" />
      <img class="<%= section %>__sparkle <%= section %>__sparkle--bottom" src="../images/oshiete/talk/talk-stars-small@2x.png" alt="" loading="lazy" />
      <h3 class="<%= section %>__who-header"><span class="hidden-pc">WHO is キャサリン？</span><span class="hidden-sp">WHO’s キャサリン！？</span></h3>
      <p class="<%= section %>__who-text">大切な友人たちを励ましたくて、算命学を<br class="visible-sm">本気で学び始めた女の子。<br class="hidden-sm">気になる人の<br class="visible-sm">ことは、ついおせっかいしたくなる世話<br class="visible-sm">焼きタイプ。<br class="hidden-sm">世界のパワースポット巡りが<br class="visible-sm">趣味で、実はゴリラが大好きです。</p>
    </div>
    <img class="<%= section %>__decoration <%= section %>__decoration--hand" src="../images/oshiete/talk/talk-hand-pc@2x.png" alt="" loading="lazy" />
  </div>
  <div class="<%= section %>__chara">
    <img class="<%= section %>__chara-image <%= section %>__chara-image--sp" src="../images/oshiete/talk/talk-chara-sp@2x.png" alt="" loading="lazy" />
    <img class="<%= section %>__chara-image <%= section %>__chara-image--pc" src="../images/oshiete/talk/talk-chara-pc@2x.png" alt="" loading="lazy" />

  </div>
</section>
