<% const section = "fortune"; -%>
<section class="section section--wave feature <%= section %>">
  <div class="section__inner feature__inner <%= section %>__inner">
    <h2 class="feature__title <%= section %>__title">
      <img src="../images/oshiete/fortune/fortune-title@2x.png" alt="運勢" loading="lazy" />
    </h2>
    <div class="feature__content <%= section %>__content">
      <h3 class="feature__header <%= section %>__header">攻める時期と<br class="hidden-pc">整える時期を知る。</h3>
      <p class="feature__text <%= section %>__text">年運や月運から、今のあなたに流れている運気のバイオリズムを<br class="hidden-tb">読み解きます。挑戦に追い風が吹く時期や、慎重に進みたい時期を知ることで、<br class="hidden-tb">人生のタイミングを味方につけることができます。</p>
      <img class="feature__image <%= section %>__image" src="../images/oshiete/fortune/fortune-image@2x.png" alt="天中殺月 コントロールが難しく、課題や問題が表出してくる時。安定期周囲の理解や支援を得られる。手応えを感じる時。中落ち期 急にモチベーションが下がる時。判断を間違えないように" loading="lazy" />
    </div>
    <img class="feature__decoration <%= section %>__decoration" src="../images/oshiete/fortune/fortune-flower-pc@2x.png" alt="" loading="lazy" />
  </div>
</section>
