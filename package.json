{
  "name": "oshiete-web",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "ejs": "node task/ejs.js",
    "watch:ejs": "onchange './src/**/*.ejs' './src/**/*.json' -- npm run ejs",
    "dev": "npm-run-all -p devFast buildWatch watch:ejs",
    "dev:fast": "npm-run-all -p devFast watch:ejs",
    "devFast": "webpack serve --config webpack.dev.js",
    "build": "npm run ejs && webpack --config webpack.prod.js",
    "buildWatch": "webpack --watch --config webpack.prod.js",
    "lint:ejs": "find src/ejs -type f -iname '*.ejs' -exec bash -c \"./node_modules/.bin/ejslint '{}'\" \\;"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "core-js": "^3.50.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "ejs": "^6.0.1",
    "ejs-lint": "^2.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-webpack-plugin": "^6.0.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "js-beautify": "^2.0.3",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all2": "^8.0.4",
    "onchange": "^7.1.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "normalize.css": "^8.0.1"
  }
}
